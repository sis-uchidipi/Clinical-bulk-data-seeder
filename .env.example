# Local settings for the Clinical Seeder. Copy this file to `.env` (or run `npm run setup`) and fill it in.
# `.env` is git-ignored: never commit it or paste its values anywhere. This repository is public.

# Remittance Posting only: the Azure AD "API to API" app the gateway accepts for ElectronicRemittanceIntake.
# Leave these empty when the SIS automation repo is cloned next to the seeder: they are read from it at startup.
# Otherwise ask your team lead for the values. Every other tracker works without them.
SIS_ERA_TENANT_ID=
SIS_ERA_CLIENT_ID=
SIS_ERA_CLIENT_SECRET=

# Optional: where the SIS automation repo is, when it isn't next to the seeder.
# SIS_AUTOMATION_REPO=C:/path/to/SISDomainsAutomation

# Optional: another port for the UI (default 4100).
# PORT=4100
